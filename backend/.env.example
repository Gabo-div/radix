PORT=1323

# Identidad de este servidor de borde. Queda grabada en cada fila que escribe
# (origin_node) y es lo que permite decidir, cuando dos nodos editaron la misma
# fila, cuál cambio gana. Por defecto es el hostname; hay que fijarla a mano si
# dos nodos pudieran compartirlo.
NODE_ID=edge-a

LOG_BUFFER_SIZE=200
CORS_ORIGINS=*
ENVIRONMENT=development
DB_PATH=./data/radix.db
TURSO_URL=http://localhost:8080
TURSO_AUTH_TOKEN=

# goose CLI only (manual migrations: goose create/status/up/down) — the app
# itself runs embedded migrations programmatically, doesn't read these.
GOOSE_DRIVER=turso
GOOSE_DBSTRING=http://localhost:8080
GOOSE_MIGRATION_DIR=./internal/database/migrations

# --- Sincronización entre nodos (opcional) ---
# URLs base de los nodos pares de los que este servidor tira operaciones,
# separadas por coma. Vacío = nodo aislado: sigue registrando su cola, nadie la
# lee. La sincronización es de tipo pull, así que para que dos nodos converjan
# cada uno tiene que apuntar al otro.
SYNC_PEERS=
# Secreto compartido entre los nodos. Sin él, GET /api/v1/sync/ops queda cerrado.
# Ojo: viaja en claro sobre HTTP — aceptable en una LAN de confianza, no fuera.
SYNC_TOKEN=
SYNC_INTERVAL_SECONDS=60

# Segundo nodo para probar la sincronización en una sola máquina.
#
#   cd config/docker && docker compose --profile peer up -d
#   cp backend/.env.b.example backend/.env.b
#   cd backend && ENV_FILE=.env.b go run ./cmd/server
#
# Y en el .env del primer nodo:
#   NODE_ID=edge-a
#   SYNC_PEERS=http://localhost:1324
#   SYNC_TOKEN=<el mismo de abajo>
PORT=1324
NODE_ID=central
LOG_BUFFER_SIZE=200
CORS_ORIGINS=*
ENVIRONMENT=development
DB_PATH=./data/radix-b.db
TURSO_URL=http://localhost:8081
TURSO_AUTH_TOKEN=

SYNC_PEERS=http://localhost:1323
SYNC_TOKEN=cambiar-este-secreto
SYNC_INTERVAL_SECONDS=60
